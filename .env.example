# Copy this file to ".env.local" and fill in the real values.
# Never commit the real file.

# Connection string from MongoDB Atlas (Connect -> Drivers).
MONGODB_URI=

# Optional. The database name. If empty, "pixelworld" is used.
# The name inside MONGODB_URI is ignored.
MONGODB_DB=

# Long random secret used to sign login tokens.
# Make one with: openssl rand -hex 32
# The real-time server (realtime/.dev.vars) must use the SAME value.
JWT_SECRET=

# Address of the real-time game server, without "http://" or "ws://".
# Local development: localhost:8787
# Production (set on Vercel): pixelworld-realtime.<your-subdomain>.workers.dev
# Vite puts this into the browser code, so it must not be a secret.
VITE_REALTIME_HOST=localhost:8787
